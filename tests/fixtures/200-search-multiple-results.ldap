# Multiple users found in search results (should not happen)
operation: search
result: success
code: 0
message: "Success"
searchEntries:
  - dn: "CN=John Doe,OU=Users,DC=corp,DC=example,DC=com"
    objectClass: ["top", "person", "organizationalPerson", "user"]
    sAMAccountName: ["jdoe"]
    objectGUID: ["12345678-1234-1234-1234-123456789abc"]
  - dn: "CN=John Doe Duplicate,OU=Users,DC=corp,DC=example,DC=com"
    objectClass: ["top", "person", "organizationalPerson", "user"]
    sAMAccountName: ["jdoe"]
    objectGUID: ["87654321-4321-4321-4321-cba987654321"]