# Multiple users found in search results (should not happen)
operation: search
result: success
code: 0
message: "Success"
searchEntries:
  - dn: "CN=John Doe,OU=Users,DC=corp,DC=example,DC=com"
    attributes:
      distinguishedName: "CN=John Doe,OU=Users,DC=corp,DC=example,DC=com"
      sAMAccountName: "jdoe"
  - dn: "CN=John Doe Duplicate,OU=Users,DC=corp,DC=example,DC=com"
    attributes:
      distinguishedName: "CN=John Doe Duplicate,OU=Users,DC=corp,DC=example,DC=com"
      sAMAccountName: "jdoe"